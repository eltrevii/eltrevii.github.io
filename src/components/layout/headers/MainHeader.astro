---
import Header from "../modular/Header.astro";
import Navigation from "../modular/Navigation.astro";
import NavLink from "../modular/NavLink.astro";

import { Image } from 'astro:assets';

import { breadcrumb } from "../../../scripts/page";

const { pathname } = Astro.url;
const crumb = breadcrumb(pathname.slice(1));
---
<Header>
    <!-- slot nav-left -->
    <Image slot="nav-left" loading="eager" src="/favicon.ico" alt="cat icon" width="32" height="32" class="rounded-full" />
    <h2 slot="nav-left">trevi's website</h2>
    <!-- slot nav-center -->
    <p slot="nav-center" class="italic text-white/70">{crumb}</p>
    <!-- slot nav-right -->
    <Navigation slot="nav-right">
        <NavLink href="/"            title="home"       paths='' />
  <!--  <NavLink href="/megathread/" title="megathread" paths='megathread/'                  relative={true} /> -->
        <NavLink href="/blog/"       title="blog"       paths={['blog/', 'tags/', 'posts/']} relative={true} />
    </Navigation>
</Header>
