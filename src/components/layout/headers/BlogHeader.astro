---
import Header from "../modular/Header.astro";
import Navigation from "../modular/Navigation.astro";
import NavLink from "../modular/NavLink.astro";
---
<Header color="dim" stripe="stripedim">
    <!-- slot nav-left -->
    <p slot="nav-left">BLOG</p>
    <!-- slot nav-center -->

    <!-- slot nav-right -->
    <Navigation slot="nav-right">
        <NavLink href="/blog/" title="todos los posts" paths="blog/" relative={true} />
        <NavLink href="/tags/" title="tags"            paths="tags/" relative={true} />
    </Navigation>
</Header>
